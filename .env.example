# ══════════════════════════════════════════════════════════════════
# UNA Chat - Variables de Entorno (Plantilla de Ejemplo)
# Laboratorio 6: Paradigmas de Programación
# ══════════════════════════════════════════════════════════════════

# Puerto del servidor local (default: 3000)
PORT=3000

# URL base de la aplicación donde corre UNA Chat
# En local: http://localhost:3000
# En Vercel: https://tu-proyecto.vercel.app
AUTH0_BASE_URL=http://localhost:3000

# Dominio de tu Tenant de Auth0 (debe incluir https://)
# Ejemplo: https://dev-xxxxxx.us.auth0.com
AUTH0_ISSUER_BASE_URL=https://TU_DOMINIO.auth0.com

# Client ID de tu aplicación Regular Web App en Auth0
AUTH0_CLIENT_ID=TU_CLIENT_ID_DE_AUTH0

# Client Secret de tu aplicación en Auth0 (MANTENER SECRETO)
AUTH0_CLIENT_SECRET=TU_CLIENT_SECRET_DE_AUTH0

# Clave secreta para firmar y cifrar la cookie de sesión (mínimo 32 caracteres)
AUTH0_SECRET=clave_secreta_de_al_menos_32_caracteres_aleatorios_12345
